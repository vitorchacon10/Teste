PORT=3333
JWT_SECRET=senai_zerbini_secret_dev
FRONTEND_URL=http://localhost:5173
DB_STORAGE=./database.sqlite

# Só é usada em produção (Render/Railway/etc). Deixe em branco/comentada
# no seu computador — assim o sistema continua usando o SQLite local.
# Formato: postgres://usuario:senha@host:porta/nome_do_banco
# DATABASE_URL=

# Cloudinary — usado para armazenar as fotos dos produtos em produção.
# Deixe em branco no seu computador para continuar salvando localmente
# em src/uploads. Pegue esses valores no dashboard do Cloudinary.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

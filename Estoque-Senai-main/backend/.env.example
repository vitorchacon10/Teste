PORT=3333
JWT_SECRET=senai_zerbini_secret_dev
FRONTEND_URL=http://localhost:5173
DB_STORAGE=./database.sqlite

# Só é usada em produção (Render/Railway/etc). Deixe em branco/comentada
# no seu computador — assim o sistema continua usando o SQLite local.
# Formato: postgres://usuario:senha@host:porta/nome_do_banco
# DATABASE_URL=

# Cloudinary — usado para armazenar as fotos dos produtos em produção.
# Deixe em branco no seu computador para continuar salvando localmente
# em src/uploads. Pegue esses valores no dashboard do Cloudinary.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Credenciais do usuário administrador criado automaticamente na primeira
# vez que o servidor sobe (só se ainda não existir nenhum com esse e-mail).
# Defina valores únicos em produção — não deixe o padrão de exemplo.
ADMIN_EMAIL=admin@senai.com
ADMIN_PASSWORD=123456

# Envio de e-mails (recuperação de senha, notificações de solicitação).
# EMAIL_USER: endereço Gmail que vai enviar os e-mails.
# EMAIL_APP_PASSWORD: senha de APP gerada em myaccount.google.com/apppasswords
# (não é a senha normal da conta Google).
EMAIL_USER=
EMAIL_APP_PASSWORD=
